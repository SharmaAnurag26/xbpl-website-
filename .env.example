# Copy to .env.local for local development. Set the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# --- Site -------------------------------------------------------------------
# Canonical origin used for metadata, sitemap, OG images and JSON-LD (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://xbpl.in

# --- Email (Resend) — contact form + newsletter -----------------------------
# https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that receives contact enquiries.
CONTACT_TO_EMAIL=
# Verified sender on your Resend domain, e.g. "XBPL Website <website@xbpl.in>".
CONTACT_FROM_EMAIL=
# Optional: Resend Segment ID (Resend → Audience → Segments). If set, newsletter sign-ups are
# added as contacts in this segment; otherwise a notification email is sent to CONTACT_TO_EMAIL.
RESEND_SEGMENT_ID=

# --- Rate limiting (optional, recommended in production) ---------------------
# Upstash Redis REST credentials. Without them, an in-memory limiter is used
# (per server instance only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Analytics (loaded only after cookie consent) ---------------------------
# One of: none | plausible | ga4
NEXT_PUBLIC_ANALYTICS=none
# Plausible: the domain configured in your Plausible site, e.g. xbpl.in
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# GA4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
